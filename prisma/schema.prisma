// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Condition {
  NEW
  USED
  BARELY_USED
}

enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELED
  RETURNED
  REFUNDED
}

model User {
  id           Int     @id @default(autoincrement())
  userName     String
  password     String
  phoneNumber  String  @unique
  email        String  @unique
  refreshToken Json[]
  seller       Seller?
  client       Client?
  admin        Admin?
}

model Admin {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id])
}

model Client {
  id                Int                 @id @default(autoincrement())
  loyalCustomer     Boolean             @default(false)
  amountSpent       Int                 @default(0)
  userId            Int                 @unique
  user              User                @relation(fields: [userId], references: [id])
  Addresses         String[]            @default([])
  postalCode        Int?
  favouriteProducts FavouriteProducts[]
  orders            Order[]
  comments          Comment[]
  shoppingCartId    ShoppingCart?
}

model Seller {
  id        Int               @id @default(autoincrement())
  storeName String
  trusted   Boolean           @default(false)
  userId    Int               @unique
  user      User              @relation(fields: [userId], references: [id])
  listings  SellerInventory[]
  verified  Boolean           @default(false)
}

model ShoppingCart {
  id        Int        @id @default(autoincrement())
  clientId  Int        @unique
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
}

model SellerInventory {
  id                 Int                @id @default(autoincrement())
  quantity           Int
  price              Int
  condition          Condition          @default(NEW)
  isActive           Boolean            @default(true)
  sellerId           Int
  productId          Int
  productWaranty     Json               @default("{}")
  seller             Seller             @relation(fields: [sellerId], references: [id])
  product            Product            @relation(fields: [productId], references: [id])
  cartItems          CartItem[]
  orderItems         OrderItems[]
  comments           Comment[]
  promotionsProducts PromotionListing[]

  @@unique([sellerId, productId, condition])
  @@index([productId])
}

model Product {
  id                Int                 @id @default(autoincrement())
  productName       String
  description       String
  rating            Float?              @default(0)
  attributes        Json                @default("{}")
  images            Json                @default("[]")
  videos            Json                @default("[]")
  categories        ProductCategory[]
  listings          SellerInventory[]
  favouriteProducts FavouriteProducts[]
}

model ProductCategory {
  id           Int       @id @default(autoincrement())
  categoryName String    @unique
  product      Product[]
}

model CartItem {
  id                Int             @id @default(autoincrement())
  quantity          Int
  shoppingCart      ShoppingCart    @relation(fields: [shoppingCartId], references: [id], onDelete: Cascade)
  shoppingCartId    Int
  sellerInventory   SellerInventory @relation(fields: [sellerInventoryId], references: [id])
  sellerInventoryId Int

  @@unique([shoppingCartId, sellerInventoryId])
  @@index([sellerInventoryId])
}

model FavouriteProducts {
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  Int
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  @@id([clientId, productId])
  @@index([productId])
}

model Order {
  id          Int          @id @default(autoincrement())
  orderDate   DateTime     @default(now())
  orderStatus OrderStatus  @default(PENDING_PAYMENT)
  paidAt      DateTime?
  deliveredAt DateTime?
  orderItems  OrderItems[]
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    Int
  address     String
  postalCode  Int

  @@index([clientId])
}

model OrderItems {
  id              Int             @id @default(autoincrement())
  unitPrice       Int
  quantity        Int
  discountPercent Int             @default(0)
  orderId         Int
  listingId       Int
  listing         SellerInventory @relation(fields: [listingId], references: [id])
  order           Order           @relation(fields: [orderId], references: [id])

  @@unique([orderId, listingId])
  @@index([listingId])
}

model Comment {
  id        Int             @id @default(autoincrement())
  like      Int             @default(0)
  rating    Float
  dislike   Int             @default(0)
  massage   String
  createdAt DateTime        @default(now())
  images    Json            @default("[]")
  videos    Json            @default("[]")
  listingId Int
  listing   SellerInventory @relation(fields: [listingId], references: [id], onDelete: Cascade)
  client    Client          @relation(fields: [clientId], references: [id])
  clientId  Int

  @@unique([listingId, clientId])
  @@index([clientId])
}

model Promotions {
  id                 Int                @id @default(autoincrement())
  name               String
  startDate          DateTime           @default(now())
  endDate            DateTime
  promotionsProducts PromotionListing[]
}

model PromotionListing {
  id          Int             @id @default(autoincrement())
  discount    Int
  promotionId Int
  promotion   Promotions      @relation(fields: [promotionId], references: [id])
  listingId   Int
  listing     SellerInventory @relation(fields: [listingId], references: [id])

  @@unique([promotionId, listingId])
  @@index([listingId])
}
